{
  "name": "outskirts",
  "displayName": "outskirts",
  "description": "Finds unused Swift code with outskirts: results in a side bar and the Problems panel, per project, with a hand-off to a coding agent.",
  "version": "0.2.0",
  "publisher": "tiny-earth-moon",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tiny-earth-moon/outskirts-vscode"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "swift",
    "unused code",
    "dead code"
  ],
  "activationEvents": [
    "workspaceContains:Package.swift",
    "workspaceContains:*.xcodeproj/project.pbxproj",
    "workspaceContains:*.xcworkspace/contents.xcworkspacedata",
    "workspaceContains:.outskirts.yml",
    "workspaceContains:.periphery.yml",
    "workspaceContains:*/Package.swift",
    "workspaceContains:*/*.xcodeproj/project.pbxproj",
    "workspaceContains:*/*.xcworkspace/contents.xcworkspacedata",
    "workspaceContains:*/.outskirts.yml",
    "workspaceContains:*/.periphery.yml",
    "onView:outskirts.results"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "A scan builds the project and an agent edits it, so both only run in a trusted workspace.",
      "restrictedConfigurations": [
        "outskirts.path",
        "outskirts.arguments",
        "outskirts.skipBuild",
        "outskirts.agent",
        "outskirts.agentCommand",
        "outskirts.agentVerify"
      ]
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "outskirts.scanProject",
        "title": "Scan Project",
        "category": "outskirts",
        "icon": "$(play)"
      },
      {
        "command": "outskirts.scanAll",
        "title": "Scan All Projects",
        "category": "outskirts",
        "icon": "$(run-all)"
      },
      {
        "command": "outskirts.clearProject",
        "title": "Clear Project Results",
        "category": "outskirts",
        "icon": "$(clear-all)"
      },
      {
        "command": "outskirts.openConfiguration",
        "title": "Open Configuration",
        "category": "outskirts",
        "icon": "$(gear)"
      },
      {
        "command": "outskirts.acceptBaseline",
        "title": "Accept Current Results as Baseline",
        "category": "outskirts",
        "icon": "$(pass)"
      },
      {
        "command": "outskirts.clearBaseline",
        "title": "Clear Baseline",
        "category": "outskirts"
      },
      {
        "command": "outskirts.revealProject",
        "title": "Show Project Results",
        "category": "outskirts"
      },
      {
        "command": "outskirts.scan",
        "title": "Scan",
        "category": "outskirts",
        "icon": "$(play)"
      },
      {
        "command": "outskirts.scanView",
        "title": "Scan",
        "category": "outskirts",
        "icon": "$(play)"
      },
      {
        "command": "outskirts.scanFolder",
        "title": "Scan This Project",
        "category": "outskirts",
        "icon": "$(play)"
      },
      {
        "command": "outskirts.cancel",
        "title": "Cancel Scan",
        "category": "outskirts",
        "icon": "$(debug-stop)"
      },
      {
        "command": "outskirts.clear",
        "title": "Clear Results",
        "category": "outskirts",
        "icon": "$(clear-all)"
      },
      {
        "command": "outskirts.clearFolder",
        "title": "Clear This Project",
        "category": "outskirts",
        "icon": "$(clear-all)"
      },
      {
        "command": "outskirts.refresh",
        "title": "Refresh Projects",
        "category": "outskirts",
        "icon": "$(refresh)"
      },
      {
        "command": "outskirts.groupByFile",
        "title": "Group by File",
        "category": "outskirts",
        "icon": "$(file)"
      },
      {
        "command": "outskirts.groupByKind",
        "title": "Group by Kind",
        "category": "outskirts",
        "icon": "$(list-tree)"
      },
      {
        "command": "outskirts.filterResults",
        "title": "Filter…",
        "category": "outskirts",
        "icon": "$(filter)"
      },
      {
        "command": "outskirts.filterResultsActive",
        "title": "Filter… (active)",
        "category": "outskirts",
        "icon": "$(filter-filled)"
      },
      {
        "command": "outskirts.clearFilter",
        "title": "Clear Filter",
        "category": "outskirts",
        "icon": "$(clear-all)"
      },
      {
        "command": "outskirts.scanOptions",
        "title": "Show Scan Options",
        "category": "outskirts",
        "icon": "$(settings)"
      },
      {
        "command": "outskirts.openSettings",
        "title": "Open Settings",
        "category": "outskirts",
        "icon": "$(gear)"
      },
      {
        "command": "outskirts.scanCurrentFolder",
        "title": "Scan",
        "category": "outskirts",
        "icon": "$(play)"
      },
      {
        "command": "outskirts.selectFolder",
        "title": "Select Project",
        "category": "outskirts",
        "icon": "$(root-folder)"
      },
      {
        "command": "outskirts.editSeverity",
        "title": "Change Severity",
        "category": "outskirts"
      },
      {
        "command": "outskirts.editArguments",
        "title": "Edit Extra Arguments",
        "category": "outskirts"
      },
      {
        "command": "outskirts.toggleGroupBy",
        "title": "Toggle Grouping",
        "category": "outskirts"
      },
      {
        "command": "outskirts.fixWithAgent",
        "title": "Fix with Agent",
        "category": "outskirts",
        "icon": "$(sparkle)",
        "enablement": "outskirts.hasResults"
      },
      {
        "command": "outskirts.pickAgent",
        "title": "Select Agent",
        "category": "outskirts",
        "icon": "$(sparkle)"
      },
      {
        "command": "outskirts.editConfiguration",
        "title": "Edit Configuration",
        "category": "outskirts",
        "icon": "$(file-code)"
      }
    ],
    "configuration": {
      "title": "outskirts",
      "properties": {
        "outskirts.path": {
          "type": "string",
          "default": "outskirts",
          "scope": "machine",
          "description": "Path of the outskirts executable, or its name when it is on the PATH."
        },
        "outskirts.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Extra arguments passed to `outskirts scan`, e.g. [\"--schemes\", \"App\"]."
        },
        "outskirts.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "warning",
          "scope": "resource",
          "description": "Severity of the diagnostics reported by outskirts."
        },
        "outskirts.skipBuild": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Reuse the existing index instead of building the project (passes `--skip-build`)."
        },
        "outskirts.agent": {
          "type": "string",
          "enum": [
            "",
            "claude",
            "copilot",
            "codex",
            "gemini",
            "cursor",
            "custom"
          ],
          "enumItemLabels": [
            "Ask",
            "Claude Code",
            "GitHub Copilot CLI",
            "Codex CLI",
            "Gemini CLI",
            "Cursor Agent",
            "Custom command"
          ],
          "enumDescriptions": [
            "Ask which agent to start.",
            "`claude`",
            "`copilot -i`",
            "`codex`",
            "`gemini -i`",
            "`cursor-agent`",
            "The command of `outskirts.agentCommand`."
          ],
          "default": "",
          "scope": "machine",
          "markdownDescription": "Coding agent that **Fix with Agent** starts in a terminal with the results. Empty: ask among the agents installed on the PATH."
        },
        "outskirts.agentCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Command of the custom agent (`outskirts.agent` set to `custom`): the executable first, then its arguments, with `${prompt}` as one whole argument, e.g. `[\"my-agent\", \"--interactive\", \"${prompt}\"]`. No shell is used."
        },
        "outskirts.agentVerify": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "Lets the agent of **Fix with Agent** build the project or run its tests after its changes. Off: it checks each removal by searching the code and ends with the command to run to verify."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "outskirts",
          "title": "outskirts",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "outskirts": [
        {
          "id": "outskirts.projects",
          "name": "Projects"
        },
        {
          "id": "outskirts.results",
          "name": "Results"
        },
        {
          "id": "outskirts.options",
          "name": "Scan Options",
          "visibility": "collapsed",
          "when": "outskirts.state != unavailable"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "outskirts.results",
        "contents": "No Swift package or Xcode project in this workspace. Open a folder that holds Package.swift, an Xcode project or workspace, or .outskirts.yml at its root, or a folder of such projects.\n[Refresh](command:outskirts.refresh)",
        "when": "outskirts.state == unavailable"
      },
      {
        "view": "outskirts.results",
        "contents": "Find the unused Swift code of this workspace with outskirts.\n[Scan](command:outskirts.scanView)",
        "when": "outskirts.state == none && !outskirts.scanning"
      },
      {
        "view": "outskirts.results",
        "contents": "No unused code found.\n[Scan Again](command:outskirts.scanView)",
        "when": "outskirts.state == empty && !outskirts.scanning"
      },
      {
        "view": "outskirts.results",
        "contents": "Scanning…\n[Cancel](command:outskirts.cancel)",
        "when": "outskirts.scanning && outskirts.state != results"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "outskirts.scanAll",
          "when": "view == outskirts.projects && !outskirts.scanning && outskirts.state != unavailable",
          "group": "navigation@1"
        },
        {
          "command": "outskirts.cancel",
          "when": "view == outskirts.projects && outskirts.scanning",
          "group": "navigation@1"
        },
        {
          "command": "outskirts.refresh",
          "when": "view == outskirts.projects",
          "group": "navigation@2"
        },
        {
          "command": "outskirts.scanView",
          "when": "view == outskirts.results && !outskirts.scanning && outskirts.state != unavailable",
          "group": "navigation@1"
        },
        {
          "command": "outskirts.fixWithAgent",
          "when": "view == outskirts.results && outskirts.hasResults && !outskirts.scanning",
          "group": "navigation@2"
        },
        {
          "command": "outskirts.cancel",
          "when": "view == outskirts.results && outskirts.scanning",
          "group": "navigation@1"
        },
        {
          "command": "outskirts.scanOptions",
          "when": "view == outskirts.results",
          "group": "navigation@2"
        },
        {
          "command": "outskirts.filterResults",
          "when": "view == outskirts.results && !outskirts.filtered",
          "group": "navigation@3"
        },
        {
          "command": "outskirts.filterResultsActive",
          "when": "view == outskirts.results && outskirts.filtered",
          "group": "navigation@3"
        },
        {
          "command": "outskirts.clearFilter",
          "when": "view == outskirts.results && outskirts.filtered",
          "group": "filter@1"
        },
        {
          "command": "outskirts.groupByKind",
          "when": "view == outskirts.results && outskirts.groupBy != kind",
          "group": "navigation@3"
        },
        {
          "command": "outskirts.groupByFile",
          "when": "view == outskirts.results && outskirts.groupBy == kind",
          "group": "navigation@3"
        },
        {
          "command": "outskirts.clear",
          "when": "view == outskirts.results && outskirts.state != none && outskirts.state != unavailable",
          "group": "navigation@4"
        },
        {
          "command": "outskirts.refresh",
          "when": "view == outskirts.results",
          "group": "navigation@5"
        },
        {
          "command": "outskirts.openSettings",
          "when": "view == outskirts.results",
          "group": "9_settings"
        },
        {
          "command": "outskirts.scanCurrentFolder",
          "when": "view == outskirts.options && !outskirts.scanning",
          "group": "navigation@1"
        },
        {
          "command": "outskirts.cancel",
          "when": "view == outskirts.options && outskirts.scanning",
          "group": "navigation@1"
        },
        {
          "command": "outskirts.selectFolder",
          "when": "view == outskirts.options && outskirts.severalProjects",
          "group": "navigation@2"
        },
        {
          "command": "outskirts.openSettings",
          "when": "view == outskirts.options",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "outskirts.filterResultsActive",
          "when": "false"
        },
        {
          "command": "outskirts.clearFilter",
          "when": "outskirts.filtered"
        },
        {
          "command": "outskirts.scanProject",
          "when": "false"
        },
        {
          "command": "outskirts.clearProject",
          "when": "false"
        },
        {
          "command": "outskirts.openConfiguration",
          "when": "false"
        },
        {
          "command": "outskirts.revealProject",
          "when": "false"
        },
        {
          "command": "outskirts.scanAll",
          "when": "outskirts.state != unavailable && !outskirts.scanning"
        },
        {
          "command": "outskirts.cancel",
          "when": "outskirts.scanning"
        },
        {
          "command": "outskirts.groupByFile",
          "when": "outskirts.groupBy == kind"
        },
        {
          "command": "outskirts.groupByKind",
          "when": "outskirts.groupBy != kind"
        },
        {
          "command": "outskirts.scanView",
          "when": "false"
        },
        {
          "command": "outskirts.scanFolder",
          "when": "false"
        },
        {
          "command": "outskirts.clearFolder",
          "when": "false"
        },
        {
          "command": "outskirts.scanCurrentFolder",
          "when": "false"
        },
        {
          "command": "outskirts.selectFolder",
          "when": "false"
        },
        {
          "command": "outskirts.editSeverity",
          "when": "false"
        },
        {
          "command": "outskirts.editArguments",
          "when": "false"
        },
        {
          "command": "outskirts.toggleGroupBy",
          "when": "false"
        },
        {
          "command": "outskirts.scanOptions",
          "when": "outskirts.state != unavailable"
        },
        {
          "command": "outskirts.fixWithAgent",
          "when": "outskirts.hasResults"
        },
        {
          "command": "outskirts.pickAgent",
          "when": "outskirts.state != unavailable"
        },
        {
          "command": "outskirts.editConfiguration",
          "when": "outskirts.state != unavailable"
        }
      ],
      "view/item/context": [
        {
          "command": "outskirts.scanProject",
          "when": "view == outskirts.projects && viewItem =~ /^project\\.idle/ && !outskirts.scanning",
          "group": "inline@1"
        },
        {
          "command": "outskirts.cancel",
          "when": "view == outskirts.projects && viewItem =~ /^project\\.scanning/",
          "group": "inline@1"
        },
        {
          "command": "outskirts.clearProject",
          "when": "view == outskirts.projects && viewItem =~ /^project\\.idle\\.results/",
          "group": "inline@2"
        },
        {
          "command": "outskirts.openConfiguration",
          "when": "view == outskirts.projects && viewItem =~ /^project/",
          "group": "inline@3"
        },
        {
          "command": "outskirts.acceptBaseline",
          "when": "view == outskirts.projects && viewItem =~ /^project\\.idle/ && !outskirts.scanning",
          "group": "baseline@1"
        },
        {
          "command": "outskirts.clearBaseline",
          "when": "view == outskirts.projects && viewItem =~ /^project\\.idle/ && !outskirts.scanning",
          "group": "baseline@2"
        },
        {
          "command": "outskirts.scanFolder",
          "when": "view == outskirts.results && viewItem =~ /^folder/ && !outskirts.scanning",
          "group": "inline@1"
        },
        {
          "command": "outskirts.clearFolder",
          "when": "view == outskirts.results && viewItem =~ /^folder/",
          "group": "inline@2"
        },
        {
          "command": "outskirts.fixWithAgent",
          "when": "view == outskirts.results && viewItem == folder.results",
          "group": "inline@3"
        },
        {
          "command": "outskirts.fixWithAgent",
          "when": "view == outskirts.results && viewItem == fileGroup",
          "group": "inline@1"
        },
        {
          "command": "outskirts.fixWithAgent",
          "when": "view == outskirts.results && viewItem == result",
          "group": "inline@1"
        },
        {
          "command": "outskirts.fixWithAgent",
          "when": "view == outskirts.results && viewItem =~ /^(folder\\.results|fileGroup|result)$/",
          "group": "agent@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --minify && esbuild webview/configEditor.ts webview/configEditor.css --bundle --outdir=dist --format=iife --platform=browser --target=es2022 --minify",
    "compile": "tsc -p .",
    "lint": "eslint .",
    "typecheck": "tsc -p . --noEmit && tsc -p webview --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run compile && mocha",
    "test:integration": "npm run compile && npm run bundle && node out/test/integration/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "mocha": "12.0.3",
    "ovsx": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "minimatch": "11.0.8",
    "glob": "14.0.2"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
