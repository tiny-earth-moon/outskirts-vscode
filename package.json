{
  "name": "outskirts",
  "displayName": "outskirts",
  "description": "Shows the unused Swift code found by the outskirts CLI as diagnostics.",
  "version": "0.1.0",
  "publisher": "tiny-earth-moon",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tiny-earth-moon/outskirts-vscode"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "swift",
    "unused code",
    "dead code"
  ],
  "activationEvents": [
    "workspaceContains:Package.swift",
    "workspaceContains:*.xcodeproj",
    "workspaceContains:*.xcworkspace",
    "workspaceContains:project.yml",
    "workspaceContains:.outskirts.yml",
    "workspaceContains:.periphery.yml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "A scan builds the project, so it only runs in a trusted workspace.",
      "restrictedConfigurations": [
        "outskirts.path",
        "outskirts.arguments",
        "outskirts.skipBuild"
      ]
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "outskirts.scan",
        "title": "Scan",
        "category": "outskirts",
        "icon": "$(play)"
      },
      {
        "command": "outskirts.scanView",
        "title": "Scan",
        "category": "outskirts",
        "icon": "$(play)"
      },
      {
        "command": "outskirts.scanFolder",
        "title": "Scan This Folder",
        "category": "outskirts",
        "icon": "$(play)"
      },
      {
        "command": "outskirts.cancel",
        "title": "Cancel Scan",
        "category": "outskirts",
        "icon": "$(debug-stop)"
      },
      {
        "command": "outskirts.clear",
        "title": "Clear Results",
        "category": "outskirts",
        "icon": "$(clear-all)"
      },
      {
        "command": "outskirts.clearFolder",
        "title": "Clear This Folder",
        "category": "outskirts",
        "icon": "$(clear-all)"
      },
      {
        "command": "outskirts.groupByFile",
        "title": "Group by File",
        "category": "outskirts",
        "icon": "$(file)"
      },
      {
        "command": "outskirts.groupByKind",
        "title": "Group by Kind",
        "category": "outskirts",
        "icon": "$(list-tree)"
      },
      {
        "command": "outskirts.scanOptions",
        "title": "Scan Options…",
        "category": "outskirts",
        "icon": "$(settings)"
      },
      {
        "command": "outskirts.openSettings",
        "title": "Open Settings",
        "category": "outskirts",
        "icon": "$(gear)"
      }
    ],
    "configuration": {
      "title": "outskirts",
      "properties": {
        "outskirts.path": {
          "type": "string",
          "default": "outskirts",
          "scope": "machine",
          "description": "Path of the outskirts executable, or its name when it is on the PATH."
        },
        "outskirts.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Extra arguments passed to `outskirts scan`, e.g. [\"--schemes\", \"App\"]."
        },
        "outskirts.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "warning",
          "scope": "resource",
          "description": "Severity of the diagnostics reported by outskirts."
        },
        "outskirts.skipBuild": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Reuse the existing index instead of building the project (passes `--skip-build`)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "outskirts",
          "title": "outskirts",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "outskirts": [
        {
          "id": "outskirts.results",
          "name": "Results"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "outskirts.results",
        "contents": "No Swift package or Xcode project in this workspace. Open a folder whose root holds Package.swift, an Xcode project or workspace, project.yml or .outskirts.yml.",
        "when": "outskirts.state == unavailable"
      },
      {
        "view": "outskirts.results",
        "contents": "Find the unused Swift code of this workspace with outskirts.\n[Scan](command:outskirts.scanView)",
        "when": "outskirts.state == none && !outskirts.scanning"
      },
      {
        "view": "outskirts.results",
        "contents": "No unused code found.\n[Scan Again](command:outskirts.scanView)",
        "when": "outskirts.state == empty && !outskirts.scanning"
      },
      {
        "view": "outskirts.results",
        "contents": "Scanning…\n[Cancel](command:outskirts.cancel)",
        "when": "outskirts.scanning && outskirts.state != results"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "outskirts.scanView",
          "when": "view == outskirts.results && !outskirts.scanning && outskirts.state != unavailable",
          "group": "navigation@1"
        },
        {
          "command": "outskirts.cancel",
          "when": "view == outskirts.results && outskirts.scanning",
          "group": "navigation@1"
        },
        {
          "command": "outskirts.scanOptions",
          "when": "view == outskirts.results",
          "group": "navigation@2"
        },
        {
          "command": "outskirts.groupByKind",
          "when": "view == outskirts.results && outskirts.groupBy != kind",
          "group": "navigation@3"
        },
        {
          "command": "outskirts.groupByFile",
          "when": "view == outskirts.results && outskirts.groupBy == kind",
          "group": "navigation@3"
        },
        {
          "command": "outskirts.clear",
          "when": "view == outskirts.results && outskirts.state != none && outskirts.state != unavailable",
          "group": "navigation@4"
        },
        {
          "command": "outskirts.openSettings",
          "when": "view == outskirts.results",
          "group": "9_settings"
        }
      ],
      "commandPalette": [
        {
          "command": "outskirts.cancel",
          "when": "outskirts.scanning"
        },
        {
          "command": "outskirts.groupByFile",
          "when": "outskirts.groupBy == kind"
        },
        {
          "command": "outskirts.groupByKind",
          "when": "outskirts.groupBy != kind"
        },
        {
          "command": "outskirts.scanView",
          "when": "false"
        },
        {
          "command": "outskirts.scanFolder",
          "when": "false"
        },
        {
          "command": "outskirts.clearFolder",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "outskirts.scanFolder",
          "when": "view == outskirts.results && viewItem == folder && !outskirts.scanning",
          "group": "inline@1"
        },
        {
          "command": "outskirts.clearFolder",
          "when": "view == outskirts.results && viewItem == folder",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --minify",
    "compile": "tsc -p .",
    "lint": "eslint .",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run compile && mocha",
    "test:integration": "npm run compile && npm run bundle && node out/test/integration/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "mocha": "12.0.3",
    "ovsx": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "minimatch": "11.0.8",
    "glob": "14.0.2"
  }
}
